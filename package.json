{
  "name": "lumen-ai-notes",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "description": "An iPhone-first, local-first AI/ML curriculum reader and study studio.",
  "scripts": {
    "prebuild": "node scripts/generate_content_index.mjs",
    "dev": "vite --host 127.0.0.1",
    "dev:ai": "HOST=127.0.0.1 PORT=8787 TLS_CERT_FILE= TLS_KEY_FILE= AI_ALLOWED_ORIGINS= AI_ENABLED=true WEB_SEARCH_ENABLED=false node --env-file-if-exists=.env server/server.mjs",
    "dev:ai:search": "HOST=127.0.0.1 PORT=8787 TLS_CERT_FILE= TLS_KEY_FILE= AI_ALLOWED_ORIGINS= AI_ENABLED=true WEB_SEARCH_ENABLED=true node --env-file-if-exists=.env server/server.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "start:local-ai": "HOST=127.0.0.1 PORT=4187 TLS_CERT_FILE= TLS_KEY_FILE= AI_ALLOWED_ORIGINS= AI_ENABLED=true WEB_SEARCH_ENABLED=true node --env-file-if-exists=.env server/server.mjs",
    "start": "node --env-file-if-exists=.env server/server.mjs",
    "audit:notes": "ruby scripts/audit_notes.rb",
    "audit:app": "npm run build && node scripts/audit_app.mjs",
    "audit:unit": "node scripts/unit_audit.mjs",
    "audit:scale": "node --test src/lib/annotations.scale.test.mjs src/lib/review.scale.test.mjs src/lib/search.scale.test.mjs",
    "audit:visual": "node scripts/visual_audit.mjs",
    "audit:responsive": "node scripts/responsive_audit.mjs",
    "audit:workflow": "node scripts/workflow_audit.mjs",
    "audit:audio": "node scripts/audio_audit.mjs",
    "audit:review": "node scripts/review_audit.mjs",
    "audit:annotations": "node scripts/annotation_audit.mjs",
    "audit:storage": "node scripts/storage_audit.mjs",
    "audit:backup-memory": "node --expose-gc scripts/backup_memory_audit.mjs",
    "audit:sync": "node scripts/cross_tab_audit.mjs",
    "audit:ai": "node --test server/**/*.test.mjs src/lib/*.test.mjs",
    "audit:ai-eval": "node scripts/ai_eval.mjs",
    "audit:phone-ai": "node --test src/lib/phoneLocalAi.test.mjs",
    "audit:phone-ai-ui": "node scripts/phone_ai_ui_audit.mjs",
    "audit:mermaid": "node scripts/mermaid_ui_audit.mjs",
    "audit:chunks": "node scripts/chunk_recovery_audit.mjs",
    "audit:ai-ui": "node scripts/ai_ui_audit.mjs",
    "audit:ai-live": "node scripts/live_ai_endpoints.mjs",
    "audit:ai-live-ui": "node scripts/live_ai_workflows.mjs",
    "audit:ai-live-smoke": "node scripts/live_ai_smoke.mjs",
    "audit:ai-live-search": "node scripts/live_ai_search.mjs",
    "audit:controls": "node scripts/control_audit.mjs",
    "check": "npm run audit:notes && npm run audit:unit && npm run audit:scale && npm run audit:storage && npm run audit:backup-memory && npm run audit:ai && npm run audit:ai-eval && npm run audit:app",
    "check:browser": "node scripts/check_browser.mjs",
    "check:release": "npm run check && npm run check:browser",
    "check:live": "npm run audit:ai-live && npm run audit:ai-live-ui && npm run audit:ai-live-smoke"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.82",
    "dompurify": "3.4.14",
    "katex": "0.16.47",
    "lucide-react": "1.33.0",
    "marked": "18.0.10",
    "marked-katex-extension": "5.1.12",
    "mermaid": "11.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.0",
    "puppeteer-core": "25.8.0",
    "vite": "8.2.2"
  }
}
