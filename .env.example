# Free local inference. No cloud AI key is required or accepted.
AI_ENABLED=false
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
# Optional immutable identity check. This is the reviewed qwen3.5:4b digest as
# of 2026-08-23; verify the current operator-approved artifact before updating.
OLLAMA_MODEL_DIGEST=2a654d98e6fba55d452b7043684e9b57a947e393bbffa62485a7aac05ee4eefd

# Optional self-hosted web search. This switch makes the capability available;
# each browser request must still contain an explicit webSearch=true opt-in.
WEB_SEARCH_ENABLED=false
SEARXNG_URL=http://127.0.0.1:8080
WEB_SEARCH_TIMEOUT_MS=8000
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_ROUNDS=2
WEB_SEARCH_MAX_RESPONSE_BYTES=1048576

# Production app/API server. Non-loopback AI/search deployments require HTTPS
# and exact HTTPS origins below. `npm run dev:ai` overrides these values with a
# loopback-only HTTP profile that is compatible with Vite's local proxy.
HOST=0.0.0.0
PORT=4173

# Optional private-LAN HTTPS. Set both paths or neither. Generate them with
# scripts/create_local_https.sh so Safari can use WebGPU and install the PWA.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Local models can be slower than hosted APIs, especially after a cold start.
AI_REQUEST_TIMEOUT_MS=240000
AI_SERVICE_PROBE_TIMEOUT_MS=1500
AI_BODY_TIMEOUT_MS=12000
AI_MAX_BODY_BYTES=131072
AI_MAX_INPUT_CHARS=24000
AI_MAX_OUTPUT_TOKENS=4096
# Defaults used when the browser does not send an explicit output cap. These
# are quality/latency profiles, not permission to exceed AI_MAX_OUTPUT_TOKENS.
AI_FAST_OUTPUT_TOKENS=900
AI_BALANCED_OUTPUT_TOKENS=1800
AI_DEEP_OUTPUT_TOKENS=3200
# Explicit Ollama KV/context allocation. Lumen also applies a conservative
# UTF-8 byte budget so model/tool/schema input cannot be silently truncated.
OLLAMA_CONTEXT_WINDOW_TOKENS=16384
# Streaming safety limits. Idle/backpressure deadlines cancel the upstream
# generation; the byte ceiling includes deltas plus the final validated copy.
AI_STREAM_IDLE_TIMEOUT_MS=60000
AI_STREAM_BACKPRESSURE_TIMEOUT_MS=15000
AI_STREAM_HEARTBEAT_MS=10000
AI_STREAM_MAX_RESPONSE_BYTES=4194304
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=12
AI_MAX_CONCURRENT=2
AI_MAX_CONCURRENT_PER_CLIENT=1

# Service URLs must be loopback by default. Enable this only when Ollama or
# SearXNG is on a trusted RFC1918/ULA/private-DNS host you operate.
AI_ALLOW_PRIVATE_NETWORK_SERVICES=false

# Comma-separated exact browser origins. Required when AI or search is enabled
# on a non-loopback HOST; every entry must be HTTPS. Loopback development needs
# none. This is a browser-request defense, not user authentication.
AI_ALLOWED_ORIGINS=

# Enable only behind a trusted reverse proxy that overwrites forwarded headers.
AI_TRUST_PROXY=false
